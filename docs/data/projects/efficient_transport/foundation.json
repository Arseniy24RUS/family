  "sections": [
    {
      "id": "framework",
      "title": "Предмет и критерии оценки",
      "question": "Какие вопросы ставит экспертиза и по каким критериям оценивается проект?",
      "order": 1,
      "publication_status": "published",
      "evidence": "Предмет экспертизы охватывает девять федеральных проектов, границы отраслевого и проектного результата, согласованность целей и достаточность открытых свидетельств."
    },
    {
      "id": "logic",
      "title": "Экономические механизмы транспорта",
      "question": "Как связаны цели, мероприятия, ресурсы и ожидаемые результаты?",
      "order": 2,
      "publication_status": "published",
      "evidence": "Полные издержки, ограничивающее звено маршрута, перераспределение потоков и возможный дополнительный эффект объясняют переход от инфраструктуры к транспортной услуге."
    },
    {
      "id": "audit",
      "title": "Аудит показателей и методик",
      "question": "Какие результаты измеряет система мониторинга и чего в ней недостаёт?",
      "order": 3,
      "publication_status": "published",
      "evidence": "Период накопления, состав совокупности, нормативный знаменатель и стадия уточнения определяют смысл авиационных, цифровых, кадровых и инфраструктурных показателей."
    },
    {
      "id": "targets",
      "title": "Цели и наблюдаемые результаты",
      "question": "Что показывают сопоставимые ряды и насколько обоснованы ориентиры?",
      "order": 4,
      "publication_status": "published",
      "evidence": "Результаты 2025 года сопоставлены с датированной редакцией целей 2026 года. Состояние мощности, годовой поток и запаздывающие кадровые сведения имеют разные условия сравнения."
    },
    {
      "id": "map",
      "title": "Морские бассейны и транспортные узлы",
      "question": "Как различаются ситуации в субъектах России?",
      "order": 5,
      "publication_status": "published",
      "evidence": "Пять морских бассейнов и документированные примеры пограничных узлов показывают географию транспортной работы. Административные региональные рейтинги не рассчитываются без соответствующих наблюдений."
    },
    {
      "id": "regions",
      "title": "Коридоры и виды сообщения",
      "question": "Какие устойчивые сочетания условий и результатов можно выделить?",
      "order": 6,
      "publication_status": "published",
      "evidence": "Грузовая работа, накопленные перевозки Севморпути и структура авиационного сообщения сохраняют собственные единицы, территориальные границы и временные периоды."
    },
    {
      "id": "finance",
      "title": "Финансирование и обязательства",
      "question": "Как расходы соотносятся с задачами, результатами и территориальными потребностями?",
      "order": 7,
      "publication_status": "published",
      "evidence": "Паспортный план, бюджетные предложения, исполнение и долгосрочные обязательства представлены с самостоятельными статусами и условиями консолидации."
    },
    {
      "id": "network",
      "title": "Связи мероприятий и показателей",
      "question": "Какие направления связаны между собой и где возникают разрывы?",
      "order": 8,
      "publication_status": "published",
      "evidence": "Общая задача, неразрешённое ссылочное утверждение и лексическое сходство имеют различную доказательную силу. География и сроки проверяются отдельно для каждого предполагаемого отношения."
    },
    {
      "id": "texts",
      "title": "Документы и межпроектные связи",
      "question": "Как сформулированы задачи и что остаётся за пределами языка документов?",
      "order": 9,
      "publication_status": "published",
      "evidence": "Смысловые профили десяти паспортов исследованы в корпусе из 137 документов. Сходство формулировок проверено по обработке слов и предметному содержанию."
    },
    {
      "id": "domains",
      "title": "Девять федеральных направлений",
      "question": "Какие содержательные механизмы требуют отдельной проверки?",
      "order": 10,
      "publication_status": "published",
      "evidence": "Высокоскоростное сообщение, Северный морской путь, железные дороги, порты, водные пути, аэродромы, граница, цифровизация и кадры составляют девять направлений проекта."
    },
    {
      "id": "causal",
      "title": "Проверка дополнительного эффекта",
      "question": "Какие данные и сравнения позволят оценить вклад конкретных мер?",
      "order": 11,
      "publication_status": "published",
      "evidence": "Даты ввода, предшествующая динамика, сопоставимые маршруты и альтернативные объяснения необходимы для отделения дополнительной услуги от перераспределения существующего потока."
    },
    {
      "id": "proposals",
      "title": "Предложения экспертизы",
      "question": "Какие изменения следуют из проверенных результатов и как оценить их последствия?",
      "order": 12,
      "publication_status": "published",
      "evidence": "Предложения соединяют версии методик, готовность маршрута, условия пользования, договоры, кадровые когорты и долгосрочные обязательства."
    }
  ],
