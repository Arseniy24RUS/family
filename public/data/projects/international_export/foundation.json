  "sections": [
    {
      "id": "framework",
      "title": "Предмет и критерии оценки",
      "question": "Какие вопросы ставит экспертиза и по каким критериям оценивается проект?",
      "order": 1,
      "publication_status": "published",
      "evidence": "Экономический результат определяется с учётом цен, физических объёмов, повторных продаж, расходов государства и условий сопоставления поддержанных предприятий."
    },
    {
      "id": "logic",
      "title": "Механизмы экспортного результата",
      "question": "Как связаны цели, мероприятия, ресурсы и ожидаемые результаты?",
      "order": 2,
      "publication_status": "published",
      "evidence": "Кредитование, страхование, транспортные компенсации, зарубежные объекты, сертификация и цифровые услуги влияют на разные стадии экспортной операции."
    },
    {
      "id": "audit",
      "title": "Аудит показателей",
      "question": "Какие результаты измеряет система мониторинга и чего в ней недостаёт?",
      "order": 3,
      "publication_status": "published",
      "evidence": "Взвешенный инфраструктурный охват, поддержанные сделки, получатели помощи и накопленные цифровые счётчики имеют самостоятельные определения и правила наблюдения."
    },
    {
      "id": "targets",
      "title": "Цели и наблюдаемые результаты",
      "question": "Что показывают сопоставимые ряды и насколько обоснованы ориентиры?",
      "order": 4,
      "publication_status": "published",
      "evidence": "Планы выбранной редакции сопоставлены с годовыми итогами и одинаковыми накопленными периодами. Точность вывода зависит от методики, периода и редакции наблюдения."
    },
    {
      "id": "map",
      "title": "Территориальная концентрация экспорта",
      "question": "Как различаются ситуации в субъектах России?",
      "order": 5,
      "publication_status": "published",
      "evidence": "Региональная статистика услуг раскрывает распределение учтённых операций между 85 непересекающимися территориями. Место регистрации экспортёра может отличаться от места выполнения работ."
    },
    {
      "id": "regions",
      "title": "Региональные профили и охват",
      "question": "Какие устойчивые сочетания условий и результатов можно выделить?",
      "order": 6,
      "publication_status": "published",
      "evidence": "Аграрный экспорт, внедрение региональных инструментов и распределение субсидии центрам поддержки рассматриваются в пределах собственных территориальных совокупностей."
    },
    {
      "id": "finance",
      "title": "Финансирование и стоимость поддержки",
      "question": "Как расходы соотносятся с задачами, результатами и территориальными потребностями?",
      "order": 7,
      "publication_status": "published",
      "evidence": "Шестилетние паспортные назначения согласованы по горизонту и известному повторному учёту трансферта. Бюджетные предложения, кассовое исполнение и долгосрочные обязательства сохраняют самостоятельный статус."
    },
    {
      "id": "network",
      "title": "Связи мероприятий и показателей",
      "question": "Какие направления связаны между собой и где возникают разрывы?",
      "order": 8,
      "publication_status": "published",
      "evidence": "Принадлежность общей задаче образует 284 пары результатов и показателей. Экономическое содержание каждой связи проверяется по механизму, сроку и подтверждающим наблюдениям."
    },
    {
      "id": "texts",
      "title": "Документы и межпроектные связи",
      "question": "Как сформулированы задачи и что остаётся за пределами языка документов?",
      "order": 9,
      "publication_status": "published",
      "evidence": "Корпус из 47 профилей результатов и 18 наименований показателей используется для лексического сопоставления. Чувствительность к порогам и тематические пересечения ограничивают интерпретацию сходства."
    },
    {
      "id": "domains",
      "title": "Четыре федеральных направления",
      "question": "Какие содержательные механизмы требуют отдельной проверки?",
      "order": 10,
      "publication_status": "published",
      "evidence": "Промышленный экспорт, зарубежная инфраструктура, системные меры и экспорт продукции АПК объединяют 47 результатов и 18 вхождений показателей федеральных проектов."
    },
    {
      "id": "causal",
      "title": "Дополнительность поддержки",
      "question": "Какие данные и сравнения позволят оценить вклад конкретных мер?",
      "order": 11,
      "publication_status": "published",
      "evidence": "Дополнительный результат требует обоснованного сравнения с развитием без поддержки, согласованных цен, предшествующих наблюдений и проверки отбора участников."
    },
    {
      "id": "proposals",
      "title": "Предложения экспертизы",
      "question": "Какие изменения следуют из проверенных результатов и как оценить их последствия?",
      "order": 12,
      "publication_status": "published",
      "evidence": "Согласование определений, регистр сделок, наблюдение за эксплуатацией инфраструктуры и последовательная апробация дополнительных показателей формируют программу совершенствования мониторинга."
    }
  ],
