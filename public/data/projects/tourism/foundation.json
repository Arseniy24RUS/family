  "sections": [
    {
      "id": "framework",
      "title": "Предмет и методология",
      "question": "Какие вопросы ставит экспертиза и по каким критериям оценивается проект?",
      "order": 1,
      "publication_status": "published",
      "evidence": "Предмет экспертизы охватывает измеримость результатов, согласованность механизмов и достаточность оснований для оценки экономической и социальной отдачи."
    },
    {
      "id": "logic",
      "title": "Механизмы развития туризма",
      "question": "Как связаны цели, мероприятия, ресурсы и ожидаемые результаты?",
      "order": 2,
      "publication_status": "published",
      "evidence": "Создание инфраструктуры, фактическое использование, экономический результат и доступность услуг образуют последовательность проверяемых переходов."
    },
    {
      "id": "audit",
      "title": "Аудит показателей",
      "question": "Какие результаты измеряет система мониторинга и чего в ней недостаёт?",
      "order": 3,
      "publication_status": "published",
      "evidence": "Десять статистических кодов, один дополнительный паспортный показатель и шесть таблиц ЕМИСС сопоставлены с методиками и статусами оценок."
    },
    {
      "id": "targets",
      "title": "Цели и наблюдаемые результаты",
      "question": "Что показывают сопоставимые ряды и насколько обоснованы ориентиры?",
      "order": 4,
      "publication_status": "published",
      "evidence": "Годовые итоги 2025 года сопоставлены с редакцией целей от 16 октября 2026 года. Различия оперативных публикаций сохранены с их источниками и периодами."
    },
    {
      "id": "map",
      "title": "Территориальная концентрация поездок",
      "question": "Как различаются ситуации в субъектах России?",
      "order": 5,
      "publication_status": "published",
      "evidence": "Распределение приёма поездок по 85 территориям согласуется с общероссийским итогом. Масштаб приёма рассматривается отдельно от доступности путешествий для жителей."
    },
    {
      "id": "regions",
      "title": "Региональные профили и сезонность",
      "question": "Какие устойчивые сочетания условий и результатов можно выделить?",
      "order": 6,
      "publication_status": "published",
      "evidence": "Региональный объём приёма, локальная сезонность и курортные риски требуют разных пространственных и временных единиц наблюдения."
    },
    {
      "id": "finance",
      "title": "Финансирование и стоимость результатов",
      "question": "Как расходы соотносятся с задачами, результатами и территориальными потребностями?",
      "order": 7,
      "publication_status": "published",
      "evidence": "Федеральные строки, региональные расходы с трансфертами, внебюджетный план, бюджетные предложения и кассовое исполнение имеют самостоятельный статус."
    },
    {
      "id": "network",
      "title": "Связи мер и показателей",
      "question": "Какие направления связаны между собой и где возникают разрывы?",
      "order": 8,
      "publication_status": "published",
      "evidence": "Общая задача связывает 31 результат с показателями через 49 пар. Лексические соответствия и неразрешённые записи влияния выделены отдельно."
    },
    {
      "id": "texts",
      "title": "Документы и межпроектные связи",
      "question": "Как сформулированы задачи и что остаётся за пределами языка документов?",
      "order": 9,
      "publication_status": "published",
      "evidence": "Шесть паспортных профилей сопоставлены в корпусе из 137 документов. Лексическая близость проверяется по содержанию и чувствительности к обработке слов."
    },
    {
      "id": "domains",
      "title": "Пять федеральных направлений",
      "question": "Какие содержательные механизмы требуют отдельной проверки?",
      "order": 10,
      "publication_status": "published",
      "evidence": "Номерной фонд, крупные курорты, туристическая привлекательность, подготовка кадров и отечественное оборудование имеют разные механизмы и сроки результата."
    },
    {
      "id": "causal",
      "title": "Оценка дополнительного эффекта",
      "question": "Какие данные и сравнения позволят оценить вклад конкретных мер?",
      "order": 11,
      "publication_status": "published",
      "evidence": "Дополнительность поддержки оценивается по объектам и территориям с учётом отбора получателей, предшествующей динамики, сезонности и перераспределения спроса."
    },
    {
      "id": "proposals",
      "title": "Предложения экспертизы",
      "question": "Какие изменения следуют из проверенных результатов и как оценить их последствия?",
      "order": 12,
      "publication_status": "published",
      "evidence": "Предложения связывают согласование определений и финансов, наблюдение работающей мощности, доступность отдыха и подготовку оценки воздействия."
    }
  ],
