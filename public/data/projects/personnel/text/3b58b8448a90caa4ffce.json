      "source_url": "https://storage.strategy24.ru/files/project/202506/2067828af48409147797c431a08b6ccd.pdf",
      "local_file": "corpus/data/pdfs/f0/f0ac97d37785736b34bae6f8c3794325e5af22e4f85ba4b49b18c647419aaf43.pdf",
      "source_version": "sha256:f0ac97d37785736b34bae6f8c3794325e5af22e4f85ba4b49b18c647419aaf43 | retrieved:2026-10-19T11:42:19Z",
      "hash_kind": "source_file_bytes",
