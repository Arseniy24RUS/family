    {
      "unit_id": "fp_268:profile2",
      "document_id": "fp_268",
      "project_id": "efficient_transport",
      "kind": "goal",
      "text": "сокращение времени в пути следования пассажиров по маршруту «москва - санкт-петербург» за счет строительства высокоскоростной железнодорожной магистрали",
      "node_id": "fp_268:goal:9ebc2b14f9fa84fe",
      "source_locator": "/html/body/main/div/header/dl/dt[3]",
      "source_sha256": "e86bc40e22d4ff370964227bf20f0544a2a4e8b4f5d0f585ab596351ece82cff",
