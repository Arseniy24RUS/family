  "sections": [
    {
      "id": "framework",
      "title": "Методология",
      "question": "Какие вопросы ставит экспертиза и по каким критериям оценивается проект?",
      "order": 1,
      "section_id": "framework",
      "publication_status": "published",
      "evidence": "Последовательно проверяются содержательная обоснованность, исполнимость, наблюдаемость и общественная результативность. Объект, работающая услуга, условия жизни и дополнительный эффект требуют разных доказательств."
    },
    {
      "id": "logic",
      "title": "Логика проекта",
      "question": "Как связаны цели, мероприятия, ресурсы и ожидаемые результаты?",
      "order": 2,
      "section_id": "logic",
      "publication_status": "published",
      "evidence": "Двенадцать федеральных проектов образуют межотраслевую конструкцию. Территориальные зависимости, сроки ввода и обязательства будущих операторов определяют возможность получить совместный результат."
    },
    {
      "id": "audit",
      "title": "Аудит показателей",
      "question": "Какие результаты измеряет система мониторинга и чего в ней недостаёт?",
      "order": 3,
      "section_id": "audit",
      "publication_status": "published",
      "evidence": "Качество вывода зависит от определения показателя, накопительного характера, территориального охвата и редакции методики. Нули после положительного накопленного значения и перенос необновлённых компонентов требуют отдельной проверки."
    },
    {
      "id": "targets",
      "title": "Цели и динамика",
      "question": "Что показывают сопоставимые ряды и насколько обоснованы ориентиры?",
      "order": 4,
      "section_id": "targets",
      "publication_status": "published",
      "evidence": "Положение относительно датированного плана рассматривается вместе с сопоставимой динамикой. Годовые итоги, неполные месячные интервалы и накопленные значения сохраняют самостоятельный смысл."
    },
    {
      "id": "map",
      "title": "Территориальные различия",
      "question": "Как различаются ситуации в субъектах России?",
      "order": 5,
      "section_id": "map",
      "publication_status": "published",
      "evidence": "Распределение инфраструктурных условий по субъектам раскрывает ограничения общероссийского среднего. Сопоставимость периода, категории территории и знаменателя проверяется для каждой карты."
    },
    {
      "id": "regions",
      "title": "Инфраструктурные профили регионов",
      "question": "Какие устойчивые сочетания условий и результатов можно выделить?",
      "order": 6,
      "section_id": "regions",
      "publication_status": "published",
      "evidence": "Жилищные и транспортные характеристики формируют многомерные профили потребностей. Корреляции на общей выборке показывают совместную изменчивость признаков, без присвоения единого рейтинга эффективности."
    },
    {
      "id": "finance",
      "title": "Финансовая экспертиза",
      "question": "Как расходы соотносятся с задачами, результатами и территориальными потребностями?",
      "order": 7,
      "section_id": "finance",
      "publication_status": "published",
      "evidence": "Паспортный план всех источников, федеральная бюджетная роспись и предложения законопроекта представлены отдельно. Финансовая сверка учитывает горизонты, источники средств и различия национального и федеральных паспортов."
    },
    {
      "id": "network",
      "title": "Связи мер и результатов",
      "question": "Какие направления связаны между собой и где возникают разрывы?",
      "order": 8,
      "section_id": "network",
      "publication_status": "published",
      "evidence": "Карточки результатов и показателей сохраняют адресацию к исходному документу. Общая задача и лексическая близость помогают отбирать связи для содержательной проверки, тогда как причинный эффект требует самостоятельного исследования."
    },
    {
      "id": "texts",
      "title": "Документы и смыслы",
      "question": "Как сформулированы задачи и что остаётся за пределами языка документов?",
      "order": 9,
      "section_id": "texts",
      "publication_status": "published",
      "evidence": "Однотипные поля 98 паспортов дают основу TF-IDF и словарного анализа. Шесть спецификаций показывают устойчивость межпроектного ранжирования, а исходные контексты позволяют проверить каждое совпадение."
    },
    {
      "id": "domains",
      "title": "Направления инфраструктурной политики",
      "question": "Какие содержательные механизмы требуют отдельной проверки?",
      "order": 10,
      "section_id": "domains",
      "publication_status": "published",
      "evidence": "Жилищные, коммунальные и транспортные направления различаются механизмами реализации. В каждом случае необходим переход от создания актива к надёжной, доступной и безопасной услуге."
    },
    {
      "id": "causal",
      "title": "Причинная оценка",
      "question": "Какие данные и сравнения позволят оценить вклад конкретных мер?",
      "order": 11,
      "section_id": "causal",
      "publication_status": "published",
      "evidence": "Причинную оценку планируют до распределения поддержки. Критерии отбора, даты начала работы услуг, исходные тенденции, сетевые эффекты и вмешательства других программ входят в сравнительный дизайн."
    },
    {
      "id": "proposals",
      "title": "Предложения авторов",
      "question": "Какие изменения следуют из проверенных результатов и как оценить их последствия?",
      "order": 12,
      "section_id": "proposals",
      "publication_status": "published",
      "evidence": "Предложения направлены на территориальную увязку мероприятий, адресуемые связи, согласование редакций, готовность эксплуатации и проверяемые показатели работы услуг. Внедрение организуется по этапам с учётом сезонности."
    }
  ],
