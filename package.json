{
  "name": "semya-research-platform",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Воспроизводимая исследовательская платформа экспертизы национального проекта Семья",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "python -m http.server 8080 --directory docs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "validate": "node scripts/validate.mjs",
    "serve": "python -m http.server 8080 --directory docs",
    "forecast": "python -X utf8 scripts/build_indicator_forecasts.py",
    "demography": "python -X utf8 scripts/refresh_demography.py --fetch",
    "test:python": "python -X utf8 -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:browser": "python -X utf8 tests/run_browser.py"
  },
  "engines": {
    "node": ">=22"
  }
}
