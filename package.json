{
  "name": "national-projects-research-platform",
  "version": "2.12.0-platform.1",
  "private": true,
  "type": "module",
  "description": "Исследовательская платформа экспертизы 12 национальных проектов России",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "python scripts/build_pages.py",
    "dev": "python scripts/preview_platform.py --no-open",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "validate": "node scripts/validate.mjs",
    "serve": "python scripts/preview_platform.py --no-open",
    "forecast": "python -X utf8 scripts/build_indicator_forecasts.py",
    "demography": "python -X utf8 scripts/refresh_demography.py --fetch",
    "test:python": "python -X utf8 -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:browser": "python -X utf8 tests/run_browser.py",
    "preview": "python scripts/preview_platform.py",
    "refresh:youth": "python -X utf8 scripts/refresh_youth_emiss.py",
    "analytics:youth": "python -X utf8 scripts/build_youth_analytics.py",
    "refresh:personnel": "python -X utf8 scripts/refresh_personnel_emiss.py",
    "analytics:personnel": "python -X utf8 scripts/build_personnel_analytics.py",
    "refresh:longlife": "python -X utf8 scripts/refresh_longlife_emiss.py",
    "analytics:longlife": "python -X utf8 scripts/build_longlife_analytics.py",
    "refresh:healthtech": "python -X utf8 scripts/refresh_healthtech_emiss.py",
    "analytics:healthtech": "python -X utf8 scripts/build_healthtech_analytics.py",
    "refresh:infrastructure": "python -X utf8 scripts/refresh_infrastructure_emiss.py",
    "analytics:infrastructure": "python -X utf8 scripts/build_infrastructure_analytics.py",
    "refresh:environment": "python -X utf8 scripts/refresh_environment_emiss.py",
    "analytics:environment": "python -X utf8 scripts/build_environment_analytics.py",
    "refresh:competitive": "python -X utf8 scripts/refresh_competitive_emiss.py",
    "analytics:competitive": "python -X utf8 scripts/build_competitive_analytics.py",
    "refresh:dataeconomy": "python -X utf8 scripts/refresh_dataeconomy_emiss.py",
    "analytics:dataeconomy": "python -X utf8 scripts/build_dataeconomy_analytics.py",
    "analytics:tourism": "python -X utf8 scripts/build_tourism_analytics.py",
    "refresh:tourism": "python -X utf8 scripts/refresh_tourism_emiss.py",
    "analytics:transport": "python -X utf8 scripts/build_transport_analytics.py",
    "refresh:transport": "python -X utf8 scripts/refresh_transport_emiss.py",
    "analytics:export": "python -X utf8 scripts/build_export_analytics.py",
    "refresh:export": "python -X utf8 scripts/refresh_export_emiss.py"
  },
  "engines": {
    "node": ">=22"
  }
}
